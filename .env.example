# Copy this file to .env and put your OWN key there. NEVER put a real key in this file
# and never commit .env (it is in .gitignore).

# ---- Option A (default): Hugging Face Inference Providers (uses HF credits) ----
HF_TOKEN=your_api_key_here
MODEL_NAME=openai/gpt-oss-120b

# ---- Option B: Groq (free tier, key from console.groq.com) ----
# HF_TOKEN=your_api_key_here          # the variable keeps the name HF_TOKEN
# LLM_BASE_URL=https://api.groq.com/openai/v1
# MODEL_NAME=openai/gpt-oss-120b

# ---- Option C: Ollama running on your own PC (free, offline) ----
# HF_TOKEN=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# MODEL_NAME=llama3.2
